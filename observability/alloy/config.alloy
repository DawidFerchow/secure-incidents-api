logging {
  level  = "info"
  format = "json"
}
discovery.docker "application" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.dawidferchow.logs=true"]
  }
}

discovery.relabel "application" {
  targets = discovery.docker.application.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    replacement  = "secure-incidents"
    target_label = "stack"
  }
}

loki.source.docker "application" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.application.output
  forward_to       = [loki.process.application.receiver]
  refresh_interval = "5s"
}

loki.process "application" {
  stage.json {
    expressions = {
      event = "event",
      level = "level",
    }
  }

  stage.labels {
    values = {
      event = "",
      level = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
